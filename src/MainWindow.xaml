<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WARDOGS • Mortar Fast Calc" Width="1200" Height="880" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#080A0D" Foreground="#EDF0F3" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8B949E"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0C1015"/><Setter Property="Foreground" Value="#F3F5F6"/><Setter Property="CaretBrush" Value="#BDE8EF"/>
   <Setter Property="BorderBrush" Value="#333B44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="FontSize" Value="17"/><Setter Property="FontFamily" Value="Consolas"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A3DDE6"/><Setter Property="Background" Value="#141C24"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="#E6EBF0"/><Setter Property="BorderBrush" Value="#333B44"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#BDE8EF"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B8C2CC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#101419"/><Setter Property="BorderBrush" Value="#252C34"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
 </Window.Resources>
 <Grid Margin="28,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="W A R D O G S    /    F I E L D   T O O L S" Foreground="#9AA6B2" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Mortar alignment" FontSize="30" FontWeight="Light" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="Pin" Content="Keep on top" Margin="0,0,20,0" ToolTip="Ctrl+T"/><Button x:Name="Help" Content="Guide · F1"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="20">
      <StackPanel>
       <TextBlock Text="POSITION &amp; TARGET" FontWeight="SemiBold" FontSize="11" Foreground="#C1CAD3" Margin="0,0,0,19"/>
       <TextBlock Text="Your mortar" FontWeight="SemiBold"/><TextBlock Text="Paste X / Y coordinates   ·   Ctrl+1" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
       <TextBox x:Name="Origin" AutomationProperties.Name="Your mortar coordinates" MaxLength="512" ToolTip="Example: x98.43, y110.38"/>
       <TextBlock Text="Target" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="Paste X / Y coordinates   ·   Ctrl+2" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
       <TextBox x:Name="Target" AutomationProperties.Name="Target coordinates" MaxLength="512" ToolTip="Example: x94.53, y109.03"/>
       <TextBlock Text="Distance override" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="Optional meters · blank = automatic   ·   Ctrl+3" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/>
       <TextBox x:Name="Distance" AutomationProperties.Name="Distance override in meters" MaxLength="12"/>
       <TextBlock x:Name="InputStatus" MinHeight="44" Foreground="#A8C5D1" FontSize="11" Margin="0,12,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="Save" Content="Save · Enter" Background="#E5EAF0" Foreground="#101419" BorderBrush="#E5EAF0" Padding="8,10"/>
        <Button Grid.Column="2" x:Name="NewTarget" Content="New · Ctrl+N" Padding="8,10"/>
       </Grid>
       <TextBlock Text="1 coordinate = 100 m · X east / Y north" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,16,0,0">
      <StackPanel><TextBlock Text="SAVED TARGETS" FontSize="11" FontWeight="SemiBold" Foreground="#C1CAD3"/><TextBlock Text="Ctrl+H · ↑ ↓ select · Enter recall · Delete remove" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/>
       <ListBox x:Name="History" Height="68" Background="#0C1015" Foreground="#E2EAF1" BorderThickness="0" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Saved targets"/>
       <TextBlock x:Name="HistoryHint" Text="Enter saves the current setup." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
     <StackPanel>
      <Grid Margin="22,18,22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="L81 MORTAR" FontSize="11" FontWeight="SemiBold" Foreground="#C1CAD3"/><TextBlock Text="Alignment view" FontSize="23" FontWeight="Light" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ViewTop" Content="Top" ToolTip="Toggle overhead view. Space while the 3D view is focused." FontSize="11" Padding="10,6" Margin="0,0,6,0"/><Button x:Name="ViewReset" Content="Reset" ToolTip="Reset camera. Home while the 3D view is focused." FontSize="11" Padding="10,6"/></StackPanel>
      </Grid>
      <Border x:Name="SceneHost" Height="300" Margin="10,5,10,0" Background="#101419" Focusable="True" Cursor="SizeAll" AutomationProperties.Name="Interactive 3D mortar view" ToolTip="Drag to orbit. Arrow keys rotate, plus/minus zoom, Space toggles top view, Home resets. Ctrl+4 focuses this view.">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#91CBD6"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid ClipToBounds="True"><Viewport3D x:Name="SceneViewport" IsHitTestVisible="False"/><Canvas x:Name="SceneLabels" IsHitTestVisible="False"/><TextBlock x:Name="SceneState" Text="Enter coordinates to align" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="#9DA9B4" FontSize="10" Margin="14,7,0,0" IsHitTestVisible="False"/></Grid>
      </Border>
      <Grid Margin="22,0,22,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Drag to orbit · Ctrl+4 + arrow keys" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="Illustrative pose · not to scale" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
      <Border BorderBrush="#2A323B" BorderThickness="0,1,0,1" Padding="22,18">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="BEARING" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Bearing" Text="—" FontSize="36" FontFamily="Segoe UI Light" Margin="0,4,0,3"/><TextBlock x:Name="Direction" Text="Compass heading" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="RNG / METERS" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Range" Text="—" FontSize="36" FontFamily="Segoe UI Light" Margin="0,4,0,3"/><TextBlock x:Name="RangeDetail" Text="Calculated distance" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="ELEVATION" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Mil" Text="— MIL" FontSize="28" FontFamily="Segoe UI Light" Margin="0,10,0,6"/><TextBlock Text="Community estimate" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       </Grid>
      </Border>
      <StackPanel Margin="22,17,22,20">
       <TextBlock x:Name="RangeStatus" Text="WAITING FOR COORDINATES" FontSize="10" FontWeight="SemiBold" Foreground="#B6C1CA"/>
       <TextBlock x:Name="Instruction" MinHeight="37" FontSize="12" Foreground="#C3CDD6" Margin="0,9,0,14"/>
       <Button x:Name="Copy" Content="Copy callout · Ctrl+Shift+C"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Text="OFFLINE    /    UNOFFICIAL WARDOGS COMPANION" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="Example" Grid.Column="1" Content="Load example" Padding="10,5" FontSize="11"/></Grid>
 </Grid>
</Window>

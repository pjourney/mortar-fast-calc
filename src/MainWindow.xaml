<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WARDOGS • Mortar Fast Calc" Width="1200" Height="880" MinWidth="560" MinHeight="500" WindowStartupLocation="CenterScreen"
 Background="#080A0D" Foreground="#EDF0F3" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8B949E"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0C1015"/><Setter Property="Foreground" Value="#F3F5F6"/><Setter Property="CaretBrush" Value="#BDE8EF"/>
   <Setter Property="BorderBrush" Value="#333B44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="FontSize" Value="17"/><Setter Property="FontFamily" Value="Consolas"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A3DDE6"/><Setter Property="Background" Value="#141C24"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="#E6EBF0"/><Setter Property="BorderBrush" Value="#333B44"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#BDE8EF"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B8C2CC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#101419"/><Setter Property="BorderBrush" Value="#252C34"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Margin="22,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="W A R D O G S   /   F I E L D   T O O L S" Foreground="#9AA6B2" FontSize="10"/><TextBlock x:Name="AppTitle" Text="Mortar alignment" FontSize="28" FontWeight="Light" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="Pin" Content="Keep on top" Margin="0,0,12,0" ToolTip="Ctrl+T"/><Button x:Name="Help" Content="Guide · F1" Padding="10,7"/></StackPanel>
  </Grid>
  <Border x:Name="ResultsCard" Grid.Row="1" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14">
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="BEARING" FontSize="10" Foreground="{StaticResource Muted}"/><Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="Bearing" Text="—" FontSize="36" FontFamily="Segoe UI Light" TextWrapping="NoWrap"/></Viewbox><TextBlock x:Name="Direction" Text="Compass heading" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="RNG / METERS" FontSize="10" Foreground="{StaticResource Muted}"/><Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="Range" Text="—" FontSize="36" FontFamily="Segoe UI Light" TextWrapping="NoWrap"/></Viewbox><TextBlock x:Name="RangeDetail" Text="Calculated distance" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="ELEVATION" FontSize="10" Foreground="{StaticResource Muted}"/><Viewbox Height="40" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="Mil" Text="— MIL" FontSize="30" FontFamily="Segoe UI Light" TextWrapping="NoWrap"/></Viewbox><TextBlock Text="Community estimate" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="RangeStatus" Text="WAITING FOR COORDINATES" FontSize="10" FontWeight="SemiBold" Foreground="#B6C1CA" Margin="0,8,0,0"/>
   </Grid>
  </Border>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid x:Name="BodyGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="280"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Border x:Name="InputCard" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="18">
     <StackPanel>
      <TextBlock Text="POSITION &amp; TARGET" FontWeight="SemiBold" FontSize="11" Foreground="#C1CAD3" Margin="0,0,0,14"/>
      <TextBlock Text="Your mortar · Ctrl+1" FontWeight="SemiBold"/><TextBox x:Name="Origin" AutomationProperties.Name="Your mortar coordinates" MaxLength="512" Margin="0,6,0,10" ToolTip="Example: x98.43, y110.38"/>
      <TextBlock Text="Target · Ctrl+2" FontWeight="SemiBold"/><TextBox x:Name="Target" AutomationProperties.Name="Target coordinates" MaxLength="512" Margin="0,6,0,10" ToolTip="Example: x94.53, y109.03"/>
      <TextBlock Text="Distance override · Ctrl+3" FontWeight="SemiBold"/><TextBlock Text="Optional meters · blank = automatic" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/><TextBox x:Name="Distance" AutomationProperties.Name="Distance override in meters" MaxLength="12" Margin="0,6,0,10"/>
      <TextBlock Text="Target name · Ctrl+5" FontWeight="SemiBold"/><TextBox x:Name="TargetName" AutomationProperties.Name="Target name, optional" MaxLength="60" FontFamily="Segoe UI" FontSize="14" Margin="0,6,0,0" ToolTip="Optional name, such as North bridge. F2 renames a saved target."/>
      <TextBlock x:Name="InputStatus" MinHeight="30" Foreground="#A8C5D1" FontSize="11" Margin="0,10,0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Save" Content="Save · Enter" Background="#E5EAF0" Foreground="#101419" BorderBrush="#E5EAF0" Padding="8,9"/><Button Grid.Column="2" x:Name="NewTarget" Content="New · Ctrl+N" Padding="8,9"/></Grid>
      <TextBlock Text="1 coordinate = 100 m · X east / Y north" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,12"/>
      <TextBlock x:Name="Instruction" FontSize="11" Foreground="#C3CDD6" Margin="0,0,0,12"/>
      <Button x:Name="Copy" Content="Copy callout · Ctrl+Shift+C" Padding="8,9"/>
     </StackPanel>
    </Border>
    <Border x:Name="SceneCard" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="18,12,18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Alignment view" FontSize="22" FontWeight="Light"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ViewTop" Content="Top" ToolTip="Toggle overhead view. Space in the 3D view." FontSize="11" Padding="10,6" Margin="0,0,6,0"/><Button x:Name="ViewReset" Content="Reset" ToolTip="Reset camera. Home in the 3D view." FontSize="11" Padding="10,6"/></StackPanel></Grid>
      <Border Grid.Row="1" x:Name="SceneHost" MinHeight="140" Margin="8,4,8,0" Background="#101419" Focusable="True" Cursor="SizeAll" AutomationProperties.Name="Interactive 3D mortar view" ToolTip="Drag to orbit. Arrow keys rotate, plus/minus zoom, Space toggles top view, Home resets. Ctrl+4 focuses this view.">
       <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#91CBD6"/></Trigger></Style.Triggers></Style></Border.Style>
       <Grid ClipToBounds="True"><Viewport3D x:Name="SceneViewport" IsHitTestVisible="False"/><Canvas x:Name="SceneLabels" IsHitTestVisible="False"/><TextBlock x:Name="SceneState" Text="Enter coordinates to align" VerticalAlignment="Top" Foreground="#9DA9B4" FontSize="10" Margin="10,5,10,0" IsHitTestVisible="False"/></Grid>
      </Border>
      <TextBlock Grid.Row="2" Text="Drag to orbit · Ctrl+4 + arrows · Illustrative pose, not to scale" FontSize="10" Foreground="{StaticResource Muted}" Margin="18,4,18,12"/>
     </Grid>
    </Border>
    <Border x:Name="HistoryCard" Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SAVED TARGETS" FontSize="11" FontWeight="SemiBold" Foreground="#C1CAD3"/><TextBlock x:Name="HistoryCount" Grid.Column="1" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
      <Grid Grid.Row="1" Margin="0,8,0,8"><TextBox x:Name="HistorySearch" MaxLength="60" FontFamily="Segoe UI" FontSize="12" Padding="8,6" AutomationProperties.Name="Search saved targets" ToolTip="Search names or coordinates · Ctrl+F · Esc clears. Down moves to results."/><TextBlock Text="Search names or coordinates · Ctrl+F" FontSize="12" Foreground="{StaticResource Muted}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <ListBox x:Name="History" Grid.Row="2" Background="#0C1015" Foreground="#E2EAF1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Saved targets">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="#141A20" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#20343D"/><Setter TargetName="Row" Property="BorderBrush" Value="#779FA8"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#BDE8EF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#263039"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding FullDetail}"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#ACB9C4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Grid.Row="3" Margin="0,8,0,0"><Button x:Name="UseTarget" Content="Use target" ToolTip="Enter. Keep your mortar position and recalculate distance." Padding="9,6" FontSize="11" Margin="0,0,6,4"/><Button x:Name="RestoreSetup" Content="Restore setup" ToolTip="Shift+Enter. Restore the saved mortar, target and override." Padding="9,6" FontSize="11" Margin="0,0,6,4"/><Button x:Name="Favorite" Content="☆ Favorite" ToolTip="F while in saved targets" Padding="9,6" FontSize="11" Margin="0,0,6,4"/><Button x:Name="RenameTarget" Content="Rename" ToolTip="F2 while in saved targets" Padding="9,6" FontSize="11" Margin="0,0,6,4"/><Button x:Name="DeleteTarget" Content="Remove" ToolTip="Delete while in saved targets" Padding="9,6" FontSize="11" Margin="0,0,0,4"/></WrapPanel>
      <TextBlock x:Name="HistoryHint" Grid.Row="4" Text="Enter saves the current setup. Ctrl+F searches saved targets." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Footer" Text="OFFLINE / UNOFFICIAL WARDOGS COMPANION" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="Example" Grid.Column="1" Content="Load example" Padding="10,5" FontSize="11"/></Grid>
 </Grid>
</Window>
